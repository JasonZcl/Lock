<Window x:Class="Lock.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="从运行中的程序选择"
        Width="760" Height="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource InfoBox}" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource Text}"
                       Text="列出当前用户正在运行的程序（含缩到托盘、没有窗口的）。请选主程序本身，例如企业微信选 WXWork.exe，而不是它目录下的 WeMail / FlutterPlugins 等组件。可多选。"/>
        </Border>

        <ListView x:Name="ProcessList" Grid.Row="1" SelectionMode="Extended"
                  MouseDoubleClick="ProcessList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="程序" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ExeName}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="窗口" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WindowText}" Foreground="{StaticResource TextMuted}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="路径" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="刷新" HorizontalAlignment="Left" Click="Refresh_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" MinWidth="80" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="添加所选" Style="{StaticResource PrimaryButton}" MinWidth="100" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
