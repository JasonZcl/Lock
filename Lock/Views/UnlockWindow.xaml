<Window x:Class="Lock.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="应用锁"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStyle="ToolWindow">
    <Border Background="{StaticResource Surface}" Padding="28,26,28,22">
        <StackPanel>
            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource Bg}" HorizontalAlignment="Center">
                <Image x:Name="AppIcon" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock x:Name="AppNameText" HorizontalAlignment="Center" Margin="0,12,0,4"
                       FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
            <TextBlock Text="此程序已被锁定，请输入密码以继续" Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>

            <PasswordBox x:Name="PasswordInput" KeyDown="PasswordInput_KeyDown"/>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>

            <Button x:Name="UnlockButton" Content="解锁" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Margin="0,16,0,8" MinHeight="38" IsDefault="True" Click="Unlock_Click"/>
            <Button Content="取消并关闭程序" HorizontalAlignment="Stretch" MinHeight="36" Click="Cancel_Click"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12">
                <Hyperlink Click="Forgot_Click">忘记密码？</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
