<Window x:Class="Lock.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="用恢复密钥重置密码"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="ToolWindow">
    <Border Background="{StaticResource Surface}" Padding="28,24">
        <StackPanel>
            <TextBlock Text="恢复密钥" Style="{StaticResource Label}"/>
            <TextBox x:Name="KeyBox" FontFamily="Consolas" FontSize="15" CharacterCasing="Upper" MinHeight="36"/>
            <TextBlock Text="设置密码时显示过的 4 组字符，不区分大小写和分隔符" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>

            <TextBlock Text="新密码（至少 4 位）" Style="{StaticResource Label}" Margin="0,16,0,6"/>
            <PasswordBox x:Name="Password1"/>

            <TextBlock Text="确认新密码" Style="{StaticResource Label}" Margin="0,14,0,6"/>
            <PasswordBox x:Name="Password2"/>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" MinWidth="80" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="OkButton" Content="重置密码" Style="{StaticResource PrimaryButton}" MinWidth="100" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
