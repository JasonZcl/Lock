<Window x:Class="Lock.Views.RecoveryKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="请保存恢复密钥"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <Border Background="{StaticResource Surface}" Padding="28,24">
        <StackPanel>
            <TextBlock Text="请保存恢复密钥" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" LineHeight="20" Margin="0,0,0,16">
                忘记密码时可以用它重置密码。它<Run FontWeight="SemiBold" Foreground="{StaticResource Text}">只显示这一次</Run>，请抄写或复制到安全的地方保存。
            </TextBlock>

            <Border Style="{StaticResource WarnBox}" Padding="16,14">
                <TextBox x:Name="KeyText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                         FontFamily="Consolas" FontSize="24" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource Text}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="复制" MinWidth="80" Margin="0,0,8,0" Click="Copy_Click"/>
                <Button Content="我已保存" Style="{StaticResource PrimaryButton}" MinWidth="100" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
