<Window x:Class="Lock.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="ToolWindow">
    <Border Background="{StaticResource Surface}" Padding="28,24">
        <StackPanel>
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20"/>

            <TextBlock x:Name="Label1" Text="密码" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="Password1"/>

            <StackPanel x:Name="ConfirmPanel" Margin="0,14,0,0">
                <TextBlock Text="确认密码" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="Password2"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>

            <Grid Margin="0,20,0,0">
                <TextBlock x:Name="ForgotLink" VerticalAlignment="Center" Visibility="Collapsed" FontSize="12">
                    <Hyperlink Click="Forgot_Click">忘记密码？</Hyperlink>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" MinWidth="80" Margin="0,0,8,0" IsCancel="True"/>
                    <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="88" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
