<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Lock.Service</RootNamespace>
        <AssemblyName>AppLock.Service</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- 服务在 Session 0 运行，不需要控制台窗口 -->
        <UserSecretsId>applock-service</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lock.Core\Lock.Core.csproj" />
    </ItemGroup>

</Project>
